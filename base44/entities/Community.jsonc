{
  "name": "Community",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "license_signature_id": {
      "type": "string"
    },
    "license_version": {
      "type": "string"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "reddit": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "x": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "facebook": {
          "type": "string"
        },
        "threads": {
          "type": "string"
        },
        "bluesky": {
          "type": "string"
        },
        "tumblr": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "user_id",
    "name",
    "slug",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
