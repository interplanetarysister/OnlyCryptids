{
  "name": "ForumReply", "type": "object",
  "properties": {
    "user_id": {"type": "string"},
    "thread_id": {"type": "string"},
    "body": {"type": "string"},
    "display_name": {"type": "string"},
    "status": {"type": "string", "enum": ["visible", "hidden", "removed"]},
    "license_signature_id": {"type": "string"},
    "license_version": {"type": "string"}
  },
  "required": ["user_id", "thread_id", "body", "status"],
  "rls": {"create": false, "read": false, "update": false, "delete": false}
}
