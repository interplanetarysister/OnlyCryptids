{
  "name": "Post",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "teaser": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "visibility": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "rights_confirmed": {
      "type": "boolean"
    },
    "media_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license_signature_id": {
      "type": "string"
    },
    "license_version": {
      "type": "string"
    },
    "demo": {
      "type": "boolean"
    },
    "scene": {
      "type": "string"
    },
    "sighting_enabled": {
      "type": "boolean"
    },
    "sighting_latitude": {
      "type": "number"
    },
    "sighting_longitude": {
      "type": "number"
    },
    "sighting_precision": {
      "type": "string"
    },
    "sighting_place": {
      "type": "string"
    },
    "encounter_date": {
      "type": "string"
    },
    "sighting_firsthand": {
      "type": "boolean"
    },
    "observation_context": {
      "type": "string"
    },
    "evidence_notes": {
      "type": "string"
    },
    "alternative_explanations": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "Fiction",
        "Non-fiction"
      ],
      "description": "Editorial type; Non-fiction includes sourced research and unverified claimed encounters, not proof of a cryptid."
    }
  },
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  },
  "required": []
}
