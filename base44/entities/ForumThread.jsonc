{
  "name": "ForumThread",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden",
        "removed"
      ]
    },
    "license_signature_id": {
      "type": "string"
    },
    "license_version": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "locked": {
      "type": "boolean"
    },
    "pinned": {
      "type": "boolean"
    },
    "subcategory": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "Fiction",
        "Non-fiction"
      ],
      "description": "Editorial type; Non-fiction includes sourced research and unverified claimed encounters, not proof of a cryptid."
    }
  },
  "required": [
    "user_id",
    "title",
    "body",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
